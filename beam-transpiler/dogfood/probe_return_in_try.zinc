public class Main {
  static int f(int n) {
    try {
      if (n > 1) {
        return 10;     // early return from inside try
      }
      return 20;
    } catch (Exception e) {
      return 30;
    }
  }

  public static void main(String[] args) {
    System.out.println(f(2) + f(0));  // 30
  }
}
