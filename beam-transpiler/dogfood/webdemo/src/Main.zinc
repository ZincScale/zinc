// zinc.http server over cowboy: the Application's tree is a Store actor plus an
// HttpServer child whose handlers close over the store's handle. main() doubles as
// the test client (deterministic, self-contained). Zero FFI, zero Tuple.of/Tag.of.
record User(String id, String name) {}

class Store implements Actor {
  HashMap<String, User> users = new HashMap<String, User>();
  void put(String id, User u) { users.put(id, u); }
  User get(String id)         { return users.get(id); }
}

class HelloHandler implements Handler {
  public Response handle(Request req) { return Response.ok("hello from zinc\n"); }
}

public class Main implements Application {
  Store store = new Store();
  HttpServer server = new HttpServer(8080, Router.create()
      .get("/hello", new HelloHandler())
      .post("/users/{id}", req -> {
        User u = Json.decode(User.class, req.body());
        store.put(req.pathParam("id"), u);
        return Response.status(201);
      })
      .get("/users/{id}", req -> Response.ok(Json.encode(store.get(req.pathParam("id"))))
          .header("content-type", "application/json")));

  void main() {
    var client = HttpClient.newBuilder().connectTimeout(2000).build();
    String base = "http://127.0.0.1:8080";

    User vin = new User("7", "vin");
    var post = HttpRequest.newBuilder(base + "/users/7").POST(Json.encode(vin)).build();
    System.out.println(client.send(post).statusCode());   // 201

    var got = client.send(HttpRequest.newBuilder(base + "/users/7").GET().build());
    User back = Json.decode(User.class, got.body());
    System.out.println(back.name());                      // vin

    var hello = client.send(HttpRequest.newBuilder(base + "/hello").GET().build());
    System.out.print(hello.body());                       // hello from zinc
  }
}
