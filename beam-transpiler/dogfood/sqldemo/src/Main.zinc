// zinc.sql over a real Postgres: the pool is a supervision subtree (Db field =
// static child, connections connect in their constructors), every statement is
// prepared with positional params, rows map to records by column name, and
// transactions are a lambda riding the failure ladder (return = COMMIT,
// throw = ROLLBACK + relay). main() doubles as the test client.
record User(String id, String name) {}

class Boom extends RuntimeException {
  Boom(String message) { super(message); }
}

public class Main implements Application {
  Db db = new Db("postgres://zinc:zinc@zincsql-pg:5432/zinc", 4);

  void main() {
    db.exec("create table users (id text primary key, name text not null)");
    System.out.println(db.exec("insert into users values ($1, $2)", "7", "vin")); // 1

    var rows = db.query("select id, name from users where id = $1", "7");
    List<User> us = Json.decodeAll(User.class, rows);
    System.out.println(us.get(0).name());   // vin   <- derived row mapping
    String id = rows.get(0).get("id").asText();   // dynamic row, guarded typed bind
    System.out.println(id);                 // 7

    int added = db.transaction(tx -> {
      tx.exec("update users set name = $1 where id = $2", "vinit", "7");
      return tx.exec("insert into users values ($1, $2)", "8", "ada");
    });
    System.out.println(added);                                                // 1
    System.out.println(db.query("select id from users order by id").size());  // 2

    try {
      db.transaction(tx -> {
        tx.exec("delete from users");
        throw new Boom("abort");
      });
    } catch (Boom e) {
      // the delete rolled back: both rows are still there
      System.out.println("rolled back " + db.query("select id from users").size());
    }

    try {
      db.query("select nope");
    } catch (SqlException e) {
      System.out.println("sql error caught");
    }
  }
}
