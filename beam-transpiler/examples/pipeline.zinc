// A 3-stage multi-process pipeline, bounded memory: FileReader (source) -> Upper
// (transform) -> FileWriter (sink). Each stage runs in its own process; the bounded
// channels between them provide backpressure. This is the cross-actor streaming arch
// piece end-to-end -- a NiFi flow with a real processor in the middle.
class Upper implements Actor {
  void run(Channel<String> in, Channel<String> out) {
    while (in.hasNext()) {
      out.put(in.take().toUpperCase());   // the middle stage does real work
    }
    out.close();                          // signal end-of-stream downstream
  }
}

public class Main implements Application {
  void main() {
    String in = "/tmp/zinc_pipe_in.txt";
    String out = "/tmp/zinc_pipe_out.txt";
    String s = "";
    for (int i = 1; i <= 5; i++) {
      s += "line" + i + "\n";
    }
    Files.writeString(in, s);

    Channel<String> a = new Channel<>(2);       // reader -> transform
    Channel<String> b = new Channel<>(2);       // transform -> writer
    FileReader.pump(in, a);                      // stage 1: file -> a (spawn-and-go, no `new`)
    Upper up = new Upper();
    up.run(a, b);                                // stage 2: a -> uppercase -> b (own process)
    FileWriter fw = FileWriter.drain(b, out);    // stage 3: b -> file (handle to join)
    fw.join();                                   // wait for the pipeline to finish

    System.out.println(Files.readLines(out).size());             // 5
    System.out.println(Files.readString(out).contains("LINE3")); // true (uppercased)
  }
}
