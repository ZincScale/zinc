// try/catch -> try .. catch error:E; assigned vars phi-merge like if
public class Main {
  public static void main(String[] args) {
    int x = 0;
    try {
      x = 1 / 0;                 // badarith
    } catch (Exception e) {
      x = 7;
    }
    System.out.println(x);       // 7
    try {
      Erlang.ok(Tuple.of(Tag.error, Tag.nope));   // raises {badmatch, ...}
    } catch (Exception e) {
      System.out.println("caught");
    }
    int n = 0;
    while (true) {               // break inside catch leaves the LOOP, not the program
      try {
        n = n + 1;
        if (n > 2) {
          int boom = 1 / 0;
        }
      } catch (Exception e) {
        break;
      }
    }
    // LANGUAGE SEMANTIC (differs from Java): try is transactional — if it throws,
    // outer vars revert to their try-entry values. Iter 3 increments n to 3, crashes,
    // reverts to 2. Java would print 3.
    System.out.println(n);       // 2
  }
}
