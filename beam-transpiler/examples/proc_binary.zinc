// end-to-end binary processing with a real byte[] literal: bytes that are NOT valid text
// -- a NUL (0x00) and 0xFF (written as -1, the legal-Java signed byte). Write -> read back
// -> verify exact byte size AND byte-for-byte equality. A text/UTF impl would truncate at
// the NUL or mangle 0xFF (invalid standalone UTF-8); only a byte-safe path round-trips it.
public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_proc_bin";
    Files.createDirectories(dir);
    String path = dir + "/data.bin";

    byte[] b = {72, 73, 0, -1, 65};   // H, I, NUL, 0xFF, A  -> 5 raw bytes
    Files.writeBytes(path, b);
    byte[] back = Files.readBytes(path);

    System.out.println(Files.size(path));  // 5   (NUL + 0xFF counted, not truncated)
    System.out.println(b == back);         // true (byte-for-byte round-trip)
  }
}
