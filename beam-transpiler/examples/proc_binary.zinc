// end-to-end binary processing: write a file -> read it as raw bytes -> write those bytes
// to a second file -> verify size + content. Exercises the byte[] read/write path.
public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_proc_bin";
    Files.createDirectories(dir);
    String src = dir + "/src.dat";
    String dst = dir + "/dst.dat";

    Files.writeString(src, "binary payload");
    byte[] raw = Files.readBytes(src);   // typed byte[], a binary at runtime
    Files.writeBytes(dst, raw);

    System.out.println(Files.size(dst));        // 14
    System.out.println(Files.readString(dst));  // binary payload
  }
}
