// zinc.io streaming write -- read line -> uppercase -> write, both handles scoped via
// try-with-resources, all in ONE process: synchronous, so backpressured and bounded.
// Never materializes the whole file (8KB or 5GB, same code).
public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_write";
    Files.createDirectories(dir);
    String in = dir + "/in.txt";
    String out = dir + "/out.txt";

    String s = "";
    for (int i = 1; i <= 5; i++) {
      s += "line" + i + "\n";
    }
    Files.writeString(in, s);

    // streaming transform: the read loop drives the write directly, in-process
    try (Reader r = Files.openReader(in)) {
      try (Writer w = Files.openWriter(out)) {
        while (r.hasNextLine()) {
          w.writeLine(r.nextLine().toUpperCase());
        }
      }
    }

    System.out.println(Files.readLines(out).size());             // 5
    System.out.println(Files.readString(out).contains("LINE3")); // true

    // append mode: scoped writer opened for append
    try (Writer w = Files.openAppender(out)) {
      w.writeLine("EXTRA");
    }
    System.out.println(Files.readLines(out).size());             // 6
  }
}
