// every rung of the if / else-if / else chain must be hit, not just the middle one.
public class Main {
  static int grade(int n) {
    if (n > 10) {
      return 3;
    } else if (n > 5) {
      return 2;
    } else {
      return 1;
    }
  }

  public static void main(String[] args) {
    System.out.println(grade(20));  // 3  (first rung)
    System.out.println(grade(7));   // 2  (else-if rung)
    System.out.println(grade(1));   // 1  (else rung)
  }
}
