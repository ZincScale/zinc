class C implements Actor {
  public int get()    { return helper(); }   // a public method may call its own helper
  private int helper() { return 1; }          // in-process helper: not part of the protocol
}
public class Main {
  public static void main(String[] args) {
    C c = new C();
    System.out.println(c.helper());           // ERROR: a helper isn't callable on a handle
  }
}
