// Phase 3 tail facades: Math.*, String join/charAt/compareTo/format, List index/first/last,
// Map containsValue — the high-level, most-used surface.
public class Main {
  public static void main(String[] args) {
    double s = Math.sqrt(144.0);
    System.out.println(s);                 // 12.0
    System.out.println(Math.round(s));     // 12
    System.out.println(Math.pow(2, 5));    // 32.0
    System.out.println(Math.floor(3.7));   // 3.0
    System.out.println(Math.ceil(3.2));    // 4.0

    List<String> xs = List.of("a", "b", "c");
    System.out.println(String.join("-", xs));   // a-b-c
    System.out.println(xs.indexOf("b"));        // 1
    System.out.println(xs.indexOf("z"));        // -1
    System.out.println(xs.getFirst());          // a
    System.out.println(xs.getLast());           // c

    System.out.println("hello".charAt(1));             // e
    System.out.println("apple".compareTo("banana"));   // -1
    System.out.println(String.format("%s=%d (%.1f%%)", "x", 7, 12.5));  // x=7 (12.5%)

    var m = new HashMap<String, Integer>();
    m.put("k", 9);
    System.out.println(m.containsValue(9));     // true
    System.out.println(m.containsValue(1));     // false
  }
}
