// zinc.io v1 -- whole-file read/write, dir ops, getenv, IOException (the value-or-throw
// idiom over Erlang's {ok,_}/{error,_}). Whole-file ops are for SMALL files; large data
// streams (slice 2). println is plain stdout; failure is a catchable zinc.io.IOException.
public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_fileio";
    Files.createDirectories(dir);
    String cfg = dir + "/app.conf";

    Files.writeString(cfg, "name=zinc\n");
    Files.appendString(cfg, "port=8080\n");

    List<String> lines = Files.readLines(cfg);
    System.out.println(lines.size());                              // 2
    String content = Files.readString(cfg);
    System.out.println(content.contains("port=8080"));            // true
    System.out.println(Files.size(cfg));                          // 20
    System.out.println(Files.list(dir).size());                   // 1
    System.out.println(Files.isDirectory(dir));                   // true
    System.out.println(System.getenv("ZINC_NOPE_XYZ").isEmpty()); // true (unset -> "")

    try {
      Files.readString(dir + "/missing.conf");
    } catch (IOException e) {
      System.out.println(e.getMessage());   // no such file or directory: /tmp/zinc_fileio/missing.conf
    }

    Files.delete(cfg);
    System.out.println(Files.exists(cfg));                        // false
  }
}
