// Zinc-Go examples allow top-level statements; BEAM wraps them into main().
int doubled(int x) = x * 2
int triple(int x) = x * 3

print("doubled(5) = ${doubled(5)}")
print("triple(5) = ${triple(5)}")

var result = 0
var numbers = [1, 2, 3]
for x in numbers {
    result = result + x * 10
}
print("reduce: ${result}")
