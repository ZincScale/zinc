// Go-Zinc control-flow spelling that is also valid on BEAM.
var fruits = ["apple", "banana", "cherry"]
for (f in fruits) {
    print("fruit: ${f}")
}

var count = 0
while (count < 3) {
    print("count: ${count}")
    count = count + 1
}

var cmd = "start"
match (cmd) {
    case "start" {
        print("starting...")
    }
    case _ {
        print("unknown command")
    }
}

print("exclusive range 0..3:")
for (i in 0..3) {
    print("  ${i}")
}

print("inclusive range 1..=3:")
for (i in 1..=3) {
    print("  ${i}")
}

for (i in 0..7) {
    if (i == 3) {
        continue
    }
    if (i == 6) {
        break
    }
    print("i=${i}")
}

print("Control Flow OK")
