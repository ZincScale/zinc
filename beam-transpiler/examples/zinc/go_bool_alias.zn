record Flag(bool ok, String label)

String label(bool ok) {
    if (ok) {
        return "yes"
    }
    return "no"
}

void main() {
    bool ready = true
    var flag = Flag(ready, label(ready))
    print("ready: ${flag.ok}")
    print("label: ${flag.label}")
    print("false label: ${label(false)}")
}
