class Counter : Actor {
    int count = 0

    void add(int n) {
        count = count + n
    }

    int get() {
        return count
    }

    void boom() {
        int z = 0
        count = count / z
    }
}

class Main : Application {
    Counter counter = Counter()

    void main() {
        counter.add(7)
        print(counter.get())
        counter.boom()
        Sys.sleep(200)
        print(counter.get())
        counter.add(5)
        print(counter.get())
    }
}
