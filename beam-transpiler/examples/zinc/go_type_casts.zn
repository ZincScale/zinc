void main() {
    var a = int(42)
    print("int(42) = ${a}")

    var b = float(42)
    print("float(42) = ${b}")

    var c = long(42)
    print("long(42) = ${c}")

    var x = 255
    var d = long(x)
    print("long(x) = ${d}")

    var e = double(3)
    print("double(3) = ${e}")

    var y = 100
    var f = double(y)
    print("double(y) = ${f}")

    var g = int(3.9)
    print("int(3.9) = ${g}")
}
