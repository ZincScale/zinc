class Upper : Actor {
    void run(Channel<String> incoming, Channel<String> outgoing) {
        while incoming.hasNext() {
            outgoing.put(incoming.take().toUpperCase())
        }
        outgoing.close()
    }
}

class Main : Application {
    void main() {
        var inputFile = "/tmp/zinc_pipe_in.txt"
        var outputFile = "/tmp/zinc_pipe_out.txt"
        var s = ""
        for i in range(1, 6) {
            s = s + "line" + i + "\n"
        }
        Files.writeString(inputFile, s)

        var rawLines = Channel(2)
        var upperLines = Channel(2)
        FileReader.pump(inputFile, rawLines)
        var up = Upper()
        up.run(rawLines, upperLines)
        var fw = FileWriter.drain(upperLines, outputFile)
        fw.join()

        print(Files.readLines(outputFile).size())
        print(Files.readString(outputFile).contains("LINE3"))
    }
}
