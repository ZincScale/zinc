String? maybeName(boolean ok) {
    if ok {
        return "vin"
    }
    return null
}

(int, String) user() {
    return (7, "vin")
}

(List<int>, String[]) bundle() {
    String[] labels = ["beam", "zinc"]
    return (List<int>[2, 4, 6], labels)
}

void main() {
    String? found = maybeName(true)
    String? missing = maybeName(false)
    print("found: ${found}")
    print("missing: ${missing}")
    print("found length: ${found?.length}")
    print("missing length: ${missing?.length}")
    print("found upper: ${found?.upper()}")
    print("missing upper: ${missing?.upper()}")

    var pair = (3, "beam")
    var (n, word) = pair
    print("pair: ${n}:${word}")

    var (id, name) = user()
    print("user: ${id}:${name}")

    (int typedId, String typedName) = user()
    print("typed user: ${typedId}:${typedName}")

    (List<int> nums, String[] labels) = bundle()
    print("bundle: ${nums[1]}:${labels[0]}")
}
