void main() {
    var dir = "/tmp/zinc_fileio"
    Files.createDirectories(dir)
    var cfg = dir + "/app.conf"
    Files.writeString(cfg, "name=zinc\n")
    Files.appendString(cfg, "port=8080\n")
    var lines = Files.readLines(cfg)
    print(lines.size())
    String content = Files.readString(cfg)
    print(content.contains("port=8080"))
    print(Files.size(cfg))
    print(Files.list(dir).size())
    print(Files.isDirectory(dir))
    try {
        Files.readString(dir + "/missing.conf")
    } catch Exception e {
        print(e.getMessage())
    }
    Files.delete(cfg)
    print(Files.exists(cfg))
}
