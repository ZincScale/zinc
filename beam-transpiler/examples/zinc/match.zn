enum Color { RED, GREEN, BLUE }

String label(Color c) {
    var out = "?"
    match c {
        case RED { out = "red" }
        case GREEN, BLUE { out = "cool" }
    }
    return out
}

void main() {
    print(label(Color.RED))
    print(label(Color.BLUE))

    var x = 1
    match x {
        case 1 { print("one") }
        case _ { print("many") }
    }

    var y = 9
    match y {
        case 1 { print("one") }
        case _ { print("many") }
    }
}
