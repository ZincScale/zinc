record Address(String city)
record User(String name, int age, Address addr)

void main() {
    User u = Json.decode(User, "{\"name\":\"vin\",\"age\":40,\"addr\":{\"city\":\"sf\"},\"x\":1}")
    print(u.name)
    print(u.age + 1)
    print(u.addr.city)

    User v = Json.decode(User.class, Json.encode(u))
    print(v.age)

    var doc = Json.parse("{\"k\":{\"n\":7}}")
    var inner = doc.get("k")
    int n = inner.get("n").asInt()
    print(n)

    try {
        User bad = Json.decode(User, "{\"name\":\"x\"}")
        print(bad.name)
    } catch Exception e {
        print("missing caught")
    }
}
