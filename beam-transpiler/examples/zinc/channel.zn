class Producer : Actor {
    void run(Channel ch) {
        for i in range(0, 5) {
            ch.put("x" + i)
        }
        ch.close()
    }
}

class Main : Application {
    void main() {
        var ch = Channel(2)
        var p = Producer()
        p.run(ch)
        var count = 0
        var all = ""
        while ch.hasNext() {
            all = all + ch.take()
            count = count + 1
        }
        print(count)
        print(all)
    }
}
