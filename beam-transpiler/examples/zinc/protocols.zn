interface Greeter {
    String greet(String name)
}

class English : Greeter {
    String prefix = ""

    void init(String p) {
        prefix = p
    }

    String greet(String name) {
        return prefix + name
    }
}

class Terse : Greeter {
    String greet(String name) {
        return name + "!"
    }
}

void main() {
    Greeter g = English("hello ")
    print(g.greet("zinc"))
    g = Terse()
    print(g.greet("beam"))
    Greeter l = n -> "lambda " + n
    print(l.greet("fun"))
}
