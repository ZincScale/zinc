void main() {
    var names = List<String>["alice", "bob"]
    print("names len: ${len(names)}")
    print("first name: ${names[0]}")

    var empty = List<int>[]
    print("empty nums: ${len(empty)}")

    var scores = Map<String, int>{"alice": 10, "bob": 20}
    print("score sum: ${scores[\"alice\"] + scores[\"bob\"]}")
    print("keys len: ${len(scores.keys())}")
    print("has alice: ${scores.containsKey(\"alice\")}")

    var iterSum = 0
    for (k in scores.keys()) {
        iterSum = iterSum + scores[k]
    }
    print("iter sum: ${iterSum}")

    var nested = Map<String, List<int>>{}
    nested["odds"] = List<int>[1, 3, 5]
    var odds = nested["odds"]
    var oddSum = 0
    for (n in odds) {
        oddSum = oddSum + n
    }
    print("odds sum: ${oddSum}")
}
