// Actor methods lower to gen_server calls/casts.
class Counter : Actor {
    int count = 0

    void incr() {
        count = count + 1
    }

    void add(int n) {
        count = count + n
    }

    int get() {
        return count
    }
}

void main() {
    var c = Counter()
    c.incr()
    c.incr()
    c.add(5)
    print(c.get())
}
