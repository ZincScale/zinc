void main() {
    var h1 = 0x0
    var h2 = 0xFF
    var h3 = 0xDEAD
    print("hex: 0=${h1} 255=${h2} DEAD=${h3}")

    var h4 = 0Xff
    print("0Xff = ${h4}")

    var b1 = 0b0
    var b2 = 0b1
    var b3 = 0b10
    var b4 = 0B11111111
    print("bin: 0=${b1} 1=${b2} 2=${b3} 255=${b4}")

    var o1 = 0o0
    var o2 = 0o7
    var o3 = 0o10
    var o4 = 0O755
    print("oct: 0=${o1} 7=${o2} 8=${o3} 493=${o4}")

    var sum = 0xFF + 0b11111111 + 0o377
    print("mixed sum: ${sum}")
}
