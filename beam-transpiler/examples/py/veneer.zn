# stdlib veneer: dict subscript (statically typed), len() as the one length spelling,
# and a heterogeneous dict whose value stays dynamic until a typed crossing.
def main() {
    scores = {"a": 1, "b": 2}            # homogeneous -> HashMap<String,int>
    scores["a"] = scores["a"] + 10       # subscript read + write, type-checked
    print(scores["a"] + len(scores))     # 11 + 2 = 13

    xs = [10, 20, 30]
    print(len(xs))                        # 3
    print(len("hello"))                   # 5

    cfg = {"host": "localhost", "port": 8080}   # mixed values -> dynamic
    host: String = cfg["host"]                  # crossing makes it a String
    print(host)

    print(str(42) + "!")                  # str(): any value -> String
}
