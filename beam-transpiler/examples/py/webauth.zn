# transactional-web identity primitives: salted password hash, HMAC-signed token, request id.
# Crypto/Random/Uuid compose with the Hex/Base64 facades — the auth toolkit any backend needs.
def hashPw(pw: String, salt: String) -> String {
    return Hex.encode(Crypto.sha256(salt + pw))
}

def main() {
    h1 = hashPw("hunter2", "s4lt")
    h2 = hashPw("hunter2", "s4lt")
    print(h1 == h2)                                          # true (stable)
    print(len(h1))                                           # 64 (sha256 hex)
    sig: String = Hex.encode(Crypto.hmacSha256("key", "session=7"))
    print(len(sig))                                          # 64
    print(len(Uuid.v4()))                                   # 36 (8-4-4-4-12)
    print(Random.int(1))                                    # 0 (0..n-1)
    print(len(Base64.encode(Random.bytes(16))) > 0)        # true
}
