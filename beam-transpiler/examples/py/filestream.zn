# streaming transform via `with` (try-with-resources): bounded memory, fds scoped to the block
def main() {
    dir = "/tmp/zinc_stream_py"
    Files.createDirectories(dir)
    src = dir + "/in.txt"
    dst = dir + "/out.txt"
    s = ""
    for i in range(1, 6) {
        s = s + "line" + i + "\n"
    }
    Files.writeString(src, s)
    with Files.openReader(src) as r {
        with Files.openWriter(dst) as w {
            while r.hasNextLine() {
                w.writeLine(r.nextLine().toUpperCase())
            }
        }
    }
    print(Files.readLines(dst).size())
    out: String = Files.readString(dst)
    print(out.contains("LINE3"))
}
