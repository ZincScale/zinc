# a supervised worker crashes and is restarted with reset state
class Worker(Actor) {
    n = 0
    def add(k: int) { n = n + k }
    def get() -> int { return n }
    def boom() { z = 0
                     n = n / z }
}
class Main(Application) {
    w = Worker()
    def main() {
        w.add(5)
        print(w.get())
        w.boom()
        Sys.sleep(150)
        print(w.get())
    }
}
