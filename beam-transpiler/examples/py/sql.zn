# zinc.sql over a real Postgres: the Db pool is an Application static child (connections
# connect in their constructors), statements are prepared with positional params, rows map
# to records by column name, and transactions are a lambda on the failure ladder
# (return = COMMIT, raise = ROLLBACK + relay). main() doubles as the test client.
record User(id: String, name: String)

class Boom(Exception) {}

class Main(Application) {
    db = Db("postgres://zinc:zinc@zincsql-pg:5432/zinc", 4)

    def main(self) {
        self.db.exec("create table users (id text primary key, name text not null)")
        print(self.db.exec("insert into users values ($1, $2)", "7", "vin"))   # 1

        rows = self.db.query("select id, name from users where id = $1", "7")
        us: List<User> = Json.decodeAll(User, rows)
        print(us.get(0).name)                          # vin  <- derived row mapping
        id: String = rows.get(0).get("id").asText()    # dynamic row, guarded typed bind
        print(id)                                      # 7

        added = self.db.transaction(tx -> {
            tx.exec("update users set name = $1 where id = $2", "vinit", "7")
            return tx.exec("insert into users values ($1, $2)", "8", "ada")
        })
        print(added)                                                   # 1
        print(self.db.query("select id from users order by id").size())  # 2

        try {
            self.db.transaction(tx -> {
                tx.exec("delete from users")
                raise Boom("abort")
            })
        } except Boom as e {
            print("rolled back " + self.db.query("select id from users").size())  # 2
        }

        try {
            self.db.query("select nope")
        } except SqlException as e {
            print("sql error caught")
        }
    }
}
