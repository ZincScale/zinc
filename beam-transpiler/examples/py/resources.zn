record AppConfig(inputDir: String, output: String)

def main() {
    root = "/tmp/zinc_resources_py"
    input = Files.join(root, "in")
    nested = Files.join(input, "nested")
    out = Files.join(root, "out.txt")
    cfgPath = Files.join(root, "config.json")

    Files.createDirectories(nested + "/")
    Files.writeString(Files.join(input, "b.txt"), "bee\n")
    Files.writeString(Files.join(input, "a.txt"), "aye\n")
    Files.writeString(Files.join(nested, "c.txt"), "see\n")
    Files.writeString(Files.join(input, "ignore.tmp"), "skip\n")
    Files.writeString(cfgPath, "{\"inputDir\":\"" + input + "\",\"output\":\"" + out + "\"}")

    cfg: AppConfig = Config.decode(AppConfig, cfgPath)
    Files.writeString(cfg.output, "")
    first = ""
    count = 0
    latest = 0
    nestedSeen = false
    for src in Files.walk(cfg.inputDir) {
        if Files.extension(src).equals("txt") {
        if count == 0 { first = Files.baseName(src) }
        mt = Files.modifiedTime(src)
        if mt > latest { latest = mt }
        if Files.dirName(src).contains("nested") { nestedSeen = true }
        with Files.openReader(src) as r {
            with Files.openAppender(cfg.output) as w {
                while r.hasNextLine() {
                    w.writeLine(Files.baseName(src) + ":" + r.nextLine())
                }
            }
        }
        count = count + 1
        }
    }

    print(first)
    print(Files.extension(first))
    print(count)
    print(Files.readString(cfg.output).contains("a.txt:aye"))
    print(nestedSeen)
    print(latest > 0)
}
