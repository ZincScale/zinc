# match/case -> arrow switch; bare enum labels, multi-label, case _ default
enum Color { RED, GREEN, BLUE }

def label(c: Color) -> String {
    out = "?"
    match c {
        case RED { out = "red" }
        case GREEN, BLUE { out = "cool" }
    }
    return out
}

def main() {
    print(label(Color.RED))
    print(label(Color.BLUE))
    x = 1
    match x {
        case 1 { print("one") }
        case _ { print("many") }
    }
    y = 9
    match y {
        case 1 { print("one") }
        case _ { print("many") }
    }
}
