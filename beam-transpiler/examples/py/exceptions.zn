# user exception relayed from an actor call; the actor survives (transactional)
class NotFound(Exception) {}

class Store(Actor) {
    hits = 0
    def find(id: int) -> int {
        hits = hits + 1
        if id > 10 {
            raise NotFound("no such id")
        }
        return id * 2
    }
    def hits() -> int { return hits }
}

def main() {
    s = Store()
    print(s.find(4))
    try {
        s.find(99)
    } except NotFound as e {
        print(e.message)
    }
    print(s.hits())
    try {
        raise NotFound("local")
    } except Exception as e {
        print(e.message)
    }
}
