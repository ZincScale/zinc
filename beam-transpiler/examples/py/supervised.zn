# supervised root: Application fields are permanent children. Crash the nested child,
# the pair restarts it with reset state, the same handle keeps serving.
class Counter(Actor) {
    count = 0
    def add(n: int) { count = count + n }
    def get() -> int  { return count }
    def boom()        { z = 0
                            count = count / z }
}

class Owner(Actor) {
    inner = Counter()
    def bump(n: int) { inner.add(n) }
    def total() -> int { return inner.get() }
    def crash()        { inner.boom() }
}

class Main(Application) {
    o = Owner()
    def main() {
        o.bump(4)
        o.bump(3)
        print(o.total())
        o.crash()
        Sys.sleep(200)
        print(o.total())
        o.bump(5)
        print(o.total())
    }
}
