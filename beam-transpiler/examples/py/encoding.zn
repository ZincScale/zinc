# wide-applicability stdlib: Time / Base64 / Hex / Gzip — thin OTP-module facades
def main() {
    b64: String = Base64.encode("hi")
    print(b64)                                          # aGk=
    print(Base64.encode(Base64.decode(b64)) == b64)     # true (round-trip)
    print(Hex.encode("AB"))                             # 4142
    msg = "zinc on the beam, zinc on the beam"
    print(Gzip.decompress(Gzip.compress(msg)) == msg)   # true
    print(Time.now() > 0)                               # true
}
