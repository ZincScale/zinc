# JSON: derived record codecs + dynamic var-chaining with a guarded crossing (.asInt).
# Decode takes a bare record name (User), Pythonic; User.class still works (see v below).
record Address(city: String)
record User(name: String, age: int, addr: Address)

def main() {
    u: User = Json.decode(User, "{\"name\":\"vin\",\"age\":40,\"addr\":{\"city\":\"sf\"},\"x\":1}")
    print(u.name)
    print(u.age + 1)
    print(u.addr.city)
    v: User = Json.decode(User.class, Json.encode(u))
    print(v.age)
    doc = Json.parse("{\"k\":{\"n\":7}}")
    inner = doc.get("k")
    n: int = inner.get("n").asInt()
    print(n)
    try {
        bad: User = Json.decode(User, "{\"name\":\"x\"}")
        print(bad.name)
    } except Exception as e {
        print("missing caught")
    }
}
