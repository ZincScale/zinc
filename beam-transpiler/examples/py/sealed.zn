# sealed union + pattern matching (the zinc-flow ProcessorResult core): variants lower to
# tagged tuples, `match` destructures them, and the match is exhaustiveness-checked.
record Doc(name: String, size: int)

sealed Result {
    Ok(doc: Doc)
    Routed(route: String, doc: Doc)
    Failed(reason: String)
}

def classify(n: int) -> Result {
    if n < 0 {
        return Failed("negative")
    }
    if n > 100 {
        return Routed("big", Doc("d", n))
    }
    return Ok(Doc("d", n))
}

def handle(r: Result) -> String {
    out = "?"
    match r {
        case Ok(doc)            { out = "ok " + doc.name }
        case Routed(route, doc) { out = "route " + route }
        case Failed(reason)     { out = "fail " + reason }
    }
    return out
}

def main() {
    print(handle(classify(5)))      # ok d
    print(handle(classify(200)))    # route big
    print(handle(classify(-1)))     # fail negative
}
