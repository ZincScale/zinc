# constructor: spawn args; restart re-runs the same init
class Counter(Actor) {
    count = 0
    def init(start: int) {
        count = start
    }
    def incr() {
        count = count + 1
    }
    def get() -> int {
        return count
    }
}

def main() {
    c = Counter(40)
    c.incr()
    c.incr()
    print(c.get())
}
