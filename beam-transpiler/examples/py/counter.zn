# actor -> gen_server: void method = async cast, typed method = sync call
class Counter(Actor) {
    count = 0
    def incr() {
        count = count + 1
    }
    def add(n: int) {
        count = count + n
    }
    def get() -> int {
        return count
    }
}

def main() {
    c = Counter()
    c.incr()
    c.incr()
    c.add(5)
    print(c.get())
}
