// ternary ?: — right-associative, both branches share a type
public class Main {
  public static void main(String[] args) {
    int a = 5;
    System.out.println(a > 3 ? "big" : "small");      // big
    System.out.println(a > 10 ? 1 : a < 0 ? -1 : 0);  // 0  (nested, right-assoc)
    int max = a > 7 ? a : 7;                            // 7
    System.out.println(max);
  }
}
