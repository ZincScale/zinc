// zinc.http streaming response: download a chunked body in BOUNDED memory and pipe it
// straight to a file -- the HTTP->file streaming flow. HttpStream mirrors the file Reader
// (try-with-resources, hasNextChunk/nextChunk), demand-driven so it can't flood memory.
// main() doubles as a canned chunked HTTP server (FFI) so the run is self-contained.
import erlang.gen_tcp;
import erlang.inet;

class ChunkServer implements Actor {
  void serve(Object lsock) {
    var s = Erlang.ok(gen_tcp.accept(lsock));
    var ignored = gen_tcp.recv(s, 0);   // request head
    // HTTP/1.1 chunked response: two chunks "HELLO" + "-STREAM", then the 0-terminator
    gen_tcp.send(s, "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\ntransfer-encoding: chunked\r\n\r\n5\r\nHELLO\r\n7\r\n-STREAM\r\n0\r\n\r\n");
    gen_tcp.close(s);
  }
}

public class Main {
  public static void main(String[] args) {
    var opts = List.of(Tag.of("binary"), Tuple.of(Tag.of("active"), false), Tuple.of(Tag.of("reuseaddr"), true));
    var lsock = Erlang.ok(gen_tcp.listen(0, opts));
    int port = Erlang.ok(inet.port(lsock));
    var srv = new ChunkServer();
    srv.serve(lsock);                                   // cast: accepts in the background

    var client = HttpClient.newBuilder().connectTimeout(2000).build();
    var req = HttpRequest.newBuilder("http://127.0.0.1:" + port + "/").GET().timeout(5000).build();

    String out = "/tmp/zinc_httpstream.out";
    try (HttpStream s = client.openStream(req)) {
      try (Writer w = Files.openWriter(out)) {
        while (s.hasNextChunk()) {
          w.write(s.nextChunk());                       // byte[] chunk -> file, bounded
        }
      }
    }

    System.out.println(Files.readString(out));          // HELLO-STREAM
    System.out.println(Files.size(out));                // 12
  }
}
