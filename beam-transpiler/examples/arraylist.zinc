// ArrayList = build/index (array-module backed: add/get/set O(log n), size O(1));
// List = receive/iterate (Erlang list, for-each fast path); copyOf bridges.
// 500k appends: the old list-append lowering was O(n^2) and would blow the suite
// timeout here; the array module does it in milliseconds.
public class Main {
  public static void main(String[] args) {
    var xs = new ArrayList();
    int i = 0;
    while (i < 500000) {
      xs.add(i);
      i = i + 1;
    }
    System.out.println(xs.size());        // 500000
    System.out.println(xs.get(250000));   // 250000
    xs.set(0, 7);
    System.out.println(xs.get(0));        // 7
    var snapshot = List.copyOf(xs);
    int sum = 0;
    for (var v : snapshot) {
      if (v > 499997) {
        sum = sum + v;
      }
    }
    System.out.println(sum);              // 499998 + 499999 = 999997
  }
}
