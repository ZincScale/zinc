public class Main {
  public static void main(String[] args) {
    int acc = 0;
    for (int i = 0; i < 10; i++) {  // classic for with continue AND break
      if (i % 2 == 1) {
        continue;                   // must still run i++
      }
      if (i > 6) {
        break;                      // must not
      }
      acc += i;
    }
    System.out.println(acc);  // 0+2+4+6 = 12
  }
}
