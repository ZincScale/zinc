// THE headline demo: a handler crashes the actor, the generated supervisor
// restarts it, and the SAME handle keeps serving. Zero supervision code here.
actor Counter {
  int count = 0;
  void incr() { count = count + 1; }
  int get()   { return count; }
  void boom() { int x = 1 / 0; }   // real crash inside the actor (badarith)
}

public class Main {
  public static void main(String[] args) {
    var c = spawn Counter();
    c.incr();
    c.incr();
    c.incr();
    System.out.println(c.get());  // 3   <- working actor
    c.boom();                     //     <- crashes the gen_server process
    Thread.sleep(100);            //     <- supervisor restarts it (same registered name)
    System.out.println(c.get());  // 0   <- SAME handle serves again; state reset to init
    c.incr();
    System.out.println(c.get());  // 1   <- and it keeps working
  }
}
