// Constructor args (restart re-runs the SAME constructor), typed handle params,
// and `this` (self-casts via the hidden '$self' registered name).
actor Counter {
  int count;
  Counter(int start) { count = start; }
  void incr()        { count = count + 1; }
  int kick() {                  // sync call that queues two self-casts behind itself
    this.incr();
    this.incr();
    return 0;
  }
  int get()          { return count; }
}

public class Main {
  static void bump(Counter c) {   // handles pass like any value: type drives dispatch
    c.incr();
  }

  public static void main(String[] args) {
    var c = spawn Counter(40);
    bump(c);
    c.kick();
    System.out.println(c.get());  // 40 +1 +2 = 43
  }
}
