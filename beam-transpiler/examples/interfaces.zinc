// nominal conformance + dynamic dispatch ('$class') + SAM lambdas as plain funs
interface Greeter {
  String greet(String name);
}

class English implements Greeter {
  String prefix;
  English(String p) { prefix = p; }
  String greet(String name) { return prefix + name; }
}

class Terse implements Greeter {
  String greet(String name) { return name + "!"; }
}

public class Main {
  public static void main(String[] args) {
    Greeter g = new English("hello ");
    System.out.println(g.greet("zinc"));   // hello zinc  <- '$class' dispatch
    g = new Terse();
    System.out.println(g.greet("beam"));   // beam!       <- same call site, other class
    Greeter l = n -> "lambda " + n;        // SAM: a lambda satisfies the interface
    System.out.println(l.greet("fun"));    // lambda fun  <- fun guard, no wrapper
  }
}
