// zinc.io streaming read -- the LARGE-file path via try-with-resources. The Reader holds
// a raw fd in this process, closed at block exit; the Scanner-style loop pulls one line at
// a time, so memory is bounded (8KB or 5GB, same code). Accumulate into plain locals.
public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_stream";
    Files.createDirectories(dir);
    String path = dir + "/data.txt";

    // build a 1000-line file (s += is amortized-O(1) binary append in zinc)
    String s = "";
    for (int i = 1; i <= 1000; i++) {
      s += i + "\n";
    }
    Files.writeString(path, s);

    // stream it: sum 1..1000 = 500500 and count lines -- never holding the whole file
    int sum = 0;
    int count = 0;
    try (Reader r = Files.openReader(path)) {
      while (r.hasNextLine()) {
        sum += Integer.parseInt(r.nextLine());
        count++;
      }
    }
    System.out.println(sum);
    System.out.println(count);
  }
}
