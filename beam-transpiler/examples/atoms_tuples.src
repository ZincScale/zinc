// Atom.x -> atom; Tuple.of -> tuple; Erlang.ok unwraps {ok, V}
import erlang.string;

public class Main {
  public static void main(String[] args) {
    var parts = string.split("a,b,c", ",", Atom.all);
    System.out.println(parts.length);              // 3
    var t = Tuple.of(Atom.ok, 42);
    System.out.println(Erlang.ok(t));              // 42
    System.out.println(Tuple.get(t, 0));           // ok
  }
}
