// end-to-end JSON processing: a single object (read -> decode -> process -> encode ->
// write -> re-read -> re-decode) AND a JSON ARRAY (read -> decodeList -> iterate ->
// aggregate). decodeList closes the array-of-records gap the audit surfaced.
record Report(String title, int count, int errors) {}

public class Main {
  public static void main(String[] args) {
    String dir = "/tmp/zinc_proc_json";
    Files.createDirectories(dir);

    // --- single object round-trip through files ---
    String path = dir + "/report.json";
    Files.writeString(path, "{\"title\":\"daily\",\"count\":100,\"errors\":3}");
    Report r = Json.decode(Report.class, Files.readString(path));
    System.out.println(r.title());               // daily
    System.out.println(r.count() - r.errors());  // 97
    String out = dir + "/out.json";
    Files.writeString(out, Json.encode(r));      // egress
    Report r2 = Json.decode(Report.class, Files.readString(out));
    System.out.println(r2.count());              // 100

    // --- JSON array -> List<Report> ---
    String arrPath = dir + "/reports.json";
    Files.writeString(arrPath,
        "[{\"title\":\"a\",\"count\":10,\"errors\":1},{\"title\":\"b\",\"count\":20,\"errors\":2}]");
    List<Report> reports = Json.decodeList(Report.class, Files.readString(arrPath));
    int totalCount = 0;
    for (Report rr : reports) {
      totalCount += rr.count();
    }
    System.out.println(reports.size());          // 2
    System.out.println(totalCount);              // 30
  }
}
