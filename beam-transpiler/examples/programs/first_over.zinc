public class Main {
  static int firstOver(int[] xs, int limit) {
    for (int x : xs) {
      if (x > limit) {
        return x;       // early return out of a loop
      }
    }
    return -1;
  }

  public static void main(String[] args) {
    int[] xs = {3, 5, 7, 9};
    System.out.println(firstOver(xs, 6));  // 7
  }
}
