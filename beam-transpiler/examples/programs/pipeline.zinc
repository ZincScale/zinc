// A 3-stage multi-process pipeline, bounded memory: FileReader (source) -> Upper
// (transform) -> FileWriter (sink). Each stage runs in its own process; the bounded
// channels between them provide backpressure. This is the cross-actor streaming arch
// piece end-to-end -- a NiFi flow with a real processor in the middle.
class Upper implements Actor {
  // pull each line from `incoming`, uppercase it, push to `outgoing`
  void run(Channel<String> incoming, Channel<String> outgoing) {
    while (incoming.hasNext()) {
      outgoing.put(incoming.take().toUpperCase());   // the middle stage does real work
    }
    outgoing.close();                                // signal end-of-stream downstream
  }
}

public class Main implements Application {
  void main() {
    String inputFile = "/tmp/zinc_pipe_in.txt";
    String outputFile = "/tmp/zinc_pipe_out.txt";
    String s = "";
    for (int i = 1; i <= 5; i++) {
      s += "line" + i + "\n";
    }
    Files.writeString(inputFile, s);

    Channel<String> rawLines = new Channel<>(2);     // reader -> transform
    Channel<String> upperLines = new Channel<>(2);   // transform -> writer
    FileReader.pump(inputFile, rawLines);            // stage 1: file -> rawLines (spawn-and-go)
    Upper up = new Upper();
    up.run(rawLines, upperLines);                    // stage 2: uppercase, in up's own process
    FileWriter fw = FileWriter.drain(upperLines, outputFile);  // stage 3: upperLines -> file
    fw.join();                                       // wait for the pipeline to finish

    System.out.println(Files.readLines(outputFile).size());             // 5
    System.out.println(Files.readString(outputFile).contains("LINE3")); // true (uppercased)
  }
}
