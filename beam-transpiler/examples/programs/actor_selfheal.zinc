// THE headline demo: a static child of the Application crashes, the supervision
// tree restarts it, and the SAME handle keeps serving. Zero supervision code here.
class Counter implements Actor {
  int count = 0;
  public void incr() { count = count + 1; }
  public int get()   { return count; }
  public void boom() { int x = 1 / 0; }   // real crash inside the actor (badarith)
}

public class Main implements Application {
  Counter c = new Counter();        // root child: permanent, supervised, restarted

  void main() {
    c.incr();
    c.incr();
    c.incr();
    System.out.println(c.get());  // 3   <- working actor
    c.boom();                     //     <- crashes the gen_server process
    Sys.sleep(100);               //     <- the tree restarts it (same registered name)
    System.out.println(c.get());  // 0   <- SAME handle serves again; state reset to init
    c.incr();
    System.out.println(c.get());  // 1   <- and it keeps working
  }
}
