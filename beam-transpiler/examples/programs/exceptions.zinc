// failure ladder rung 1+2: expected failures are exceptions; a throw in a call
// method relays to the caller (catchable) and the actor survives, state intact
class NotFound extends RuntimeException {
  NotFound(String message) { super(message); }
}

class Store implements Actor {
  int hits = 0;
  public int find(int id) {
    hits = hits + 1;
    if (id > 10) {
      throw new NotFound("no such id");
    }
    return id * 2;
  }
  public int hits() { return hits; }
}

public class Main {
  public static void main(String[] args) {
    var s = new Store();
    System.out.println(s.find(4));          // 8
    try {
      s.find(99);
    } catch (NotFound e) {
      System.out.println(e.getMessage());   // no such id   <- relayed, typed catch
    }
    System.out.println(s.hits());           // 1   <- actor survived; the failed call
    // rolled back (transactional try: a relayed throw reverts state to call entry)
    try {
      throw new NotFound("local");
    } catch (Exception e) {
      System.out.println(e.getMessage());   // local   <- catch-all clause
    }
  }
}
