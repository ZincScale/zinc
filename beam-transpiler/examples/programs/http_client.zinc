// zinc.http.HttpClient over httpc -- builders + the failure ladder. No server here: a
// refused connection needs none, and it keeps the example pure client surface with zero
// FFI. The successful round-trip (client against a REAL zinc HttpServer, no faking) lives
// in dogfood/webdemo, where cowboy is available.
public class Main {
  public static void main(String[] args) {
    var client = HttpClient.newBuilder().connectTimeout(2000).build();
    var req = HttpRequest.newBuilder("http://127.0.0.1:1/none")
        .header("accept", "text/plain").GET().timeout(2000).build();
    try {
      client.send(req);
      System.out.println("no exception?!");
    } catch (HttpException e) {
      System.out.println("connect refused caught");     // ConnectException matches the parent
    }
  }
}
