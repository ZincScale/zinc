// Map iteration: entrySet() for the imperative accumulate idiom (for-each + mutable
// locals, no fold), and forEach((k,v)->...) for side-effects. The way a Java dev walks
// a Map<String,String> config map -- pervasive in zinc-flow.
public class Main {
  public static void main(String[] args) {
    Map<String, String> m = new HashMap<>();
    m.put("a", "10");
    m.put("b", "20");
    m.put("c", "30");

    // entrySet + for-each: accumulate into plain mutable locals
    int sum = 0;
    int n = 0;
    for (var e : m.entrySet()) {
      sum += Integer.parseInt(e.getValue());
      n++;
    }
    System.out.println(sum);   // 60
    System.out.println(n);     // 3

    // typed key + value compose
    int forA = 0;
    for (var e : m.entrySet()) {
      if (e.getKey().equals("a")) {
        forA = Integer.parseInt(e.getValue());
      }
    }
    System.out.println(forA);  // 10

    // forEach: side-effect (small maps iterate in sorted key order on BEAM)
    m.forEach((k, v) -> System.out.println(k + "=" + v));  // a=10 / b=20 / c=30
  }
}
