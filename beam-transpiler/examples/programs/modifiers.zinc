// Modifiers are enforced, not decorative: an Actor method is public (its message
// protocol) or private (an in-process helper -- a plain local function, NOT a message
// handler, so it takes what it needs as args). final = construction-frozen; the ctor
// may set a final field, methods may not.
class Vault implements Actor {
  final String key;
  int reads = 0;
  Vault(String k) { key = k; }
  public String get() { reads = reads + 1; return tag(key, reads); }  // public protocol
  private String tag(String k, int n) { return k + "#" + n; }         // in-process helper
}

public class Main {
  private static int twice(int x) { return x * 2; }

  public static void main(String[] args) {
    final int base = 10;
    System.out.println(twice(base) + 1);   // 21
    Vault v = new Vault("s3cret");
    System.out.println(v.get());           // s3cret
  }
}
