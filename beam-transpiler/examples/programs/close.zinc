// close() = finally at process granularity (the AutoCloseable idiom): runs as
// terminate/2 on orderly stop — here the tree draining at VM exit — never on
// the actor's own crash. Direct r.close() calls are a transpile error.
class Res implements Actor {
  String name;
  Res(String n) { name = n; }
  public int poke()   { return 1; }
  public void close() { System.out.println("closed " + name); }
}

public class Main {
  public static void main(String[] args) {
    Res r = new Res("db");
    System.out.println(r.poke());
  }
}
