// Erlang FFI: import erlang.<module> binds that OTP module; calls pass through.
// Arrays.asList is the explicit bridge from T[] (array) to the list world.
import erlang.lists;
import erlang.string;

public class Main {
  public static void main(String[] args) {
    int[] xs = {3, 1, 2};
    var l = Arrays.asList(xs);
    int total = lists.sum(l) + lists.max(lists.sort(l));    // 6 + 3 = 9
    String up = string.uppercase("beam");                   // declared type -> ~ts/concat
    System.out.println(up + "-" + total);                   // BEAM-9
  }
}
