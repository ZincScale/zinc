// happy path: actor -> gen_server; void method -> cast, typed method -> call
class Counter implements Actor {
  int count = 0;
  void incr()       { count = count + 1; }
  void add(int n)   { count = count + n; }
  int get()         { return count; }
}

public class Main {
  public static void main(String[] args) {
    var c = new Counter();
    c.incr();
    c.incr();
    c.add(5);
    System.out.println(c.get());  // 7
  }
}
