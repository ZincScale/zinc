// enum -> atoms; arrow switch with bare enum labels, multi-label, default
enum Color { RED, GREEN, BLUE }

public class Main {
  static String label(Color c) {
    String out = "?";
    switch (c) {
      case RED -> { out = "red"; }
      case GREEN, BLUE -> { out = "cool"; }
    }
    return out;
  }

  public static void main(String[] args) {
    System.out.println(label(Color.GREEN));  // cool
    int x = 2;
    switch (x) {
      case 1 -> System.out.println("one");
      default -> System.out.println("many");
    }
  }
}
