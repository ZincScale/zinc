// enum -> atoms; arrow switch with bare enum labels, multi-label, default.
// Hit the single-label arm, the multi-label arm, a MATCHED int case, and the default.
enum Color { RED, GREEN, BLUE }

public class Main {
  static String label(Color c) {
    String out = "?";
    switch (c) {
      case RED -> { out = "red"; }
      case GREEN, BLUE -> { out = "cool"; }
    }
    return out;
  }

  public static void main(String[] args) {
    System.out.println(label(Color.RED));   // red   (single-label arm)
    System.out.println(label(Color.BLUE));  // cool  (multi-label arm)
    int x = 1;
    switch (x) {
      case 1 -> System.out.println("one");   // matched case, not default
      default -> System.out.println("many");
    }
    int y = 9;
    switch (y) {
      case 1 -> System.out.println("one");
      default -> System.out.println("many"); // default arm
    }
  }
}
